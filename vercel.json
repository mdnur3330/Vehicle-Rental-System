    {
      "version": 2,
      "builds": [
        {
          "src": "dist/server.js",
          "use": "@vercel/node",
          "config": {
            "includeFiles": ["dist/**"]
          }
        }
      ],
      "routes": [
        {
          "src": "/(.*)",
          "dest": "dist/server.js",
          "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
          "headers": {
            "Access-Control-Allow-Origin": "*",
            "Access-Control-Allow-Headers": "Origin, X-Requested-With, Content-Type, Accept"
          }
        }
      ]
    }